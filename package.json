        {
          "submenu": "redlens.obj.scripting",
          "when": "view == redlensExplorer && viewItem == redlens.table",
          "group": "1_object"
        },
        {
          "submenu": "redlens.obj.governance",
          "when": "view == redlensExplorer && (viewItem == redlens.table || viewItem == redlens.schema)",
          "group": "1_object"
        },
        {
          "submenu": "redlens.obj.ai",
          "when": "view == redlensExplorer && viewItem == redlens.table",
          "group": "1_object"
        },
        {
          "command": "redlens.datashare.copyNamespace",
          "when": "view == redlensExplorer && viewItem == redlens.section.datashares",
          "group": "inline"
        },
        {
          "command": "redlens.datashare.copyNamespace",
          "when": "view == redlensExplorer && viewItem =~ /redlens.datashare.(inbound|outbound)/",
          "group": "1_share"
        },
        {
          "command": "redlens.datashare.queryObject",
          "when": "view == redlensExplorer && viewItem == redlens.dsObject",
          "group": "1_share"
        }
