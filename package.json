  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node esbuild.integration.mjs && node out-integration/runTest.js",
    "shots": "node esbuild.integration.mjs && node out-integration/runShots.js",
    "hero": "node esbuild.integration.mjs && node out-integration/runHero.js",
    "test:ui": "playwright test",
    "package": "node -e \"console.error('Do not package from inside the workspace: vsce follows npm\\\\'s hoisted node_modules and packages the whole monorepo. Use scripts/package-extension.sh {base|pro} — it stages a standalone copy. See that script for what this prevented.'); process.exit(1)\""
  },
