    "configuration": {
      "title": "RedLens",
      "properties": {
        "redlens.connections": {
          "type": "array",
          "default": [],
          "description": "Redshift connection profiles (managed by RedLens; credentials live in VS Code Secret Storage, never in settings)."
        },
        "redlens.introspectionLevel": {
          "type": "string",
          "enum": [
            "names",
            "full"
          ],
          "default": "names",
          "enumDescriptions": [
            "Load only schema/table names eagerly; fetch columns lazily (fast on large catalogs).",
            "Prefetch columns for the first schemas too (richer completion, heavier introspection)."
          ],
          "description": "How much catalog metadata RedLens preloads. Redshift introspection can be expensive on large clusters."
        },
        "redlens.piiSafeMode": {
          "type": "boolean",
          "default": false,
          "description": "PII-safe mode: mask the columns in redlens.piiColumns in the grid, exports, and — importantly — before results reach the embedded MCP server, so AI agents never see raw PII."
        },
        "redlens.piiColumns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "email",
            "ssn",
            "phone",
            "*card*",
            "password",
            "secret"
          ],
          "description": "Column-name patterns treated as PII when redlens.piiSafeMode is on. Substring match, or glob if it contains '*' (case-insensitive)."
        },
        "redlens.cloudWatch.rpuPriceUsd": {
          "type": "number",
          "default": 0.36,
          "minimum": 0,
          "description": "Price per RPU-hour used to estimate Redshift Serverless compute cost on the dashboard. The default is the us-east-1 list price; set your region's rate (or your negotiated one) so the estimate is not quietly wrong."
        },
        "redlens.telemetry.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Send anonymous usage telemetry (which RedLens commands are used). Off by default: there is no telemetry backend yet, so leaving it on would show an \"uses online services\" notice for data that goes nowhere. Never includes SQL, object names, endpoints, error messages or results. VS Code’s global telemetry setting always takes precedence: if it is off, RedLens sends nothing regardless of this.",
          "tags": [
            "telemetry",
            "usesOnlineServices"
          ]
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "redlens.mcpProvider",
